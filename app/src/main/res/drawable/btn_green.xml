<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#FF17692A" android:endColor="#FF2E9A3E" />
                <stroke android:width="1dp" android:color="#FF0B3A15" />
                <corners android:radius="10dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#FF05200B" /><corners android:radius="10dp" /></shape></item>
            <item android:bottom="3dp"><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#FF2E9A3E" android:endColor="#FF17692A" />
                <stroke android:width="1dp" android:color="#FF0B3A15" />
                <corners android:radius="10dp" /></shape></item>
        </layer-list>
    </item>
</selector>
