<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#FF7A140E" android:endColor="#FFB3261E" />
                <stroke android:width="1dp" android:color="#FF3F0906" />
                <corners android:radius="10dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#FF1F0403" /><corners android:radius="10dp" /></shape></item>
            <item android:bottom="3dp"><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#FFB3261E" android:endColor="#FF7A140E" />
                <stroke android:width="1dp" android:color="#FF3F0906" />
                <corners android:radius="10dp" /></shape></item>
        </layer-list>
    </item>
</selector>
