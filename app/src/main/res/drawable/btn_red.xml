<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#FFA81812" android:endColor="#FFE5322B" />
                <stroke android:width="1dp" android:color="#FF5A0B08" />
                <corners android:radius="10dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#FF2A0504" /><corners android:radius="10dp" /></shape></item>
            <item android:bottom="3dp"><shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#FFE5322B" android:endColor="#FFA81812" />
                <stroke android:width="1dp" android:color="#FF5A0B08" />
                <corners android:radius="10dp" /></shape></item>
        </layer-list>
    </item>
</selector>
